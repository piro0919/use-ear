{
  "name": "use-ear",
  "version": "2.0.0",
  "description": "React hooks for wake word detection using Web Speech API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "hooks",
    "speech-recognition",
    "wake-word",
    "voice",
    "web-speech-api",
    "vosk",
    "on-device",
    "offline",
    "stt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piro0919/use-ear.git"
  },
  "homepage": "https://use-ear.kkweb.io/",
  "funding": "https://github.com/sponsors/piro0919",
  "bugs": {
    "url": "https://github.com/piro0919/use-ear/issues"
  },
  "author": "piro0919 <piro.haniwa@gmail.com> (https://kkweb.io/)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:lib": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build:lib",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "react": ">=18",
    "vosk-browser": ">=0.0.8"
  },
  "peerDependenciesMeta": {
    "vosk-browser": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/analytics": "2.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild-wasm": "^0.28.2",
    "jsdom": "^30.1.1",
    "next": "16.3.7",
    "publint": "^0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-ios-pwa-prompt": "^2.0.6",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vosk-browser": "^0.0.8"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
